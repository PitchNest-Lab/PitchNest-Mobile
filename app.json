{
  "expo": {
    "name": "PitchNest",
    "slug": "pitchnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pitchnest",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pitchnest.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PitchNest can show a private camera preview while you practise, so you can check your eye contact and body language. Video is never recorded or sent.",
        "NSMicrophoneUsageDescription": "PitchNest uses your microphone so you can speak your pitch to the AI investors and coach.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pitchnest.app",
      "adaptiveIcon": {
        "backgroundColor": "#0ea5e9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0ea5e9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "PitchNest can show a private camera preview while you practise, so you can check your eye contact and body language. Video is never recorded or sent.",
          "microphonePermission": "PitchNest uses your microphone so you can speak your pitch to the AI investors and coach.",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "PitchNest uses your microphone so you can speak your pitch to the AI investors and coach.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "pitchnest-mobile"
      }
    }
  }
}
