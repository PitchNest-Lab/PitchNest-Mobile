# PitchNest Android build variables. Copy to .env for local release builds.

# Existing shared backend, set to DEV here. When these are unset the app uses PROD (the AWS API and the Render live server).
VITE_API_URL=https://l5isutzx18.execute-api.eu-west-2.amazonaws.com

# Existing backend WebSocket endpoint for the live pitch room.
VITE_WS_BACKEND_URL=wss://pitchnest-backend-dev.onrender.com/ws

# Canonical website used for public pitch links shared from Android.
VITE_PUBLIC_SITE_URL=https://www.pitchnest.app

# Google web OAuth client ID. The native plugin requests an ID token for this
# audience, which the existing backend verifies.
VITE_GOOGLE_CLIENT_ID=
